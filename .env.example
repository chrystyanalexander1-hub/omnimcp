# Copy to .env and fill in real values before running docker-compose or the apps locally.
# Never commit the real .env file — it's already in .gitignore.

DATABASE_URL=postgres://omnimcp:omnimcp@localhost:5432/omnimcp
REDIS_URL=redis://localhost:6379

# Any random string >= 32 chars. Rotate by issuing a new one; existing JWTs will stop validating.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long

# Must be a base64-encoded 32-byte key, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=XJsN3dwtRbsap4QcSI6cm27mitQiHzV3WPyFA20aBn0=

RATE_LIMIT_PER_MINUTE=120
CONNECTORS_DIR=./connectors
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# --- HTTPS (docker-compose's `caddy` service, production only) ---
# Two subdomains of a domain you own, each with an A record pointing at the
# Droplet's public IP — see docs/domain-https.md. Leave unset for local dev
# (the caddy service is only needed once you have a real domain).
DOMAIN_API=api.your-domain.com
DOMAIN_APP=app.your-domain.com
# Let's Encrypt sends renewal/expiry notices here — any address you check works.
ACME_EMAIL=you@your-domain.com
# Browser-facing rest-api URL that web-panel bakes into its build. Defaults to
# the Droplet's IP over HTTP when unset (see docker-compose.yml) — once caddy
# is serving DOMAIN_API over HTTPS, set this to https://api.your-domain.com
# and rebuild web-panel so ChatGPT Actions (which requires HTTPS) can use it.
PUBLIC_API_URL=https://api.your-domain.com

# How often apps/automation-worker checks for due scheduled workflows.
AUTOMATION_POLL_INTERVAL_SECONDS=30

# --- connectors/github ---
# A GitHub Personal Access Token is granted per-tenant via the REST API
# (POST /connectors/github/credentials), not set here as a static env var.

# --- connectors/google-drive ---
# These two ARE static, shared across every tenant — they identify OmniMCP's own
# Google OAuth app, not any individual user's account.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- connectors/meta-ads ---
# Meta's OAuth doesn't issue a standard refresh_token, so this connector uses a
# long-lived token (or, better for production, a System User token from Business
# Manager, which doesn't expire) granted per-tenant via the REST API
# (POST /connectors/meta-ads/credentials), same as the GitHub PAT — not set here.

# --- connectors/tiktok-ads ---
# Same per-tenant long-lived token pattern as GitHub/Meta Ads — granted via
# POST /connectors/tiktok-ads/credentials, not set here.

# --- connectors/whatsapp-business ---
# Same per-tenant long-lived token pattern (a System User token with
# whatsapp_business_messaging permission) — granted via
# POST /connectors/whatsapp-business/credentials, not set here.

# --- connectors/telegram ---
# Per-tenant bot token, granted via POST /connectors/telegram/credentials, not set
# here. Create a bot and get its token from @BotFather on Telegram.

# --- connectors/google-ads ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above for the OAuth flow (a tenant's
# refresh token is granted via POST /connectors/google-ads/credentials, not set
# here). The developer token below IS static and shared — it belongs to the app,
# not any tenant. GOOGLE_ADS_LOGIN_CUSTOMER_ID is optional, only needed if you
# access accounts through a Manager (MCC) account.
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- connectors/hubspot ---
# Per-tenant Private App access token, granted via POST /connectors/hubspot/credentials,
# not set here.

# --- connectors/google-analytics ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/google-analytics/credentials, not set here.

# --- connectors/youtube ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/youtube/credentials, not set here.

# --- connectors/shopify ---
# Per-tenant Custom App Admin API access token, granted via
# POST /connectors/shopify/credentials, not set here. shopDomain is passed as a
# tool argument, not env config, since one tenant may connect more than one store.

# --- connectors/postgres ---
# Per-tenant connection string to the tenant's OWN external database — not
# OmniMCP's own DATABASE_URL above. Granted via POST /connectors/postgres/credentials,
# not set here.

# --- connectors/google-cloud-storage ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/google-cloud-storage/credentials, not set here.

# --- connectors/azure-blob-storage ---
# Per-tenant Azure Storage connection string (contains AccountName + AccountKey),
# granted via POST /connectors/azure-blob-storage/credentials, not set here.

# --- connectors/firebase-firestore ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/firebase-firestore/credentials, not set here.

# --- connectors/tiktok-content ---
# Per-tenant long-lived access token from TikTok's Content Posting API (a different
# app/product than tiktok-ads), granted via POST /connectors/tiktok-content/credentials,
# not set here.

# --- connectors/facebook-pages ---
# Per-tenant Page Access Token, granted via POST /connectors/facebook-pages/credentials,
# not set here.

# --- connectors/instagram ---
# Per-tenant Instagram Business Account access token, granted via
# POST /connectors/instagram/credentials, not set here.

# --- connectors/slack ---
# Per-tenant bot token (xoxb-...), granted via POST /connectors/slack/credentials,
# not set here.

# --- connectors/notion ---
# Per-tenant integration token, granted via POST /connectors/notion/credentials,
# not set here.

# --- connectors/google-calendar ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/google-calendar/credentials, not set here.

# --- connectors/stripe ---
# Per-tenant secret key (sk_live_... or sk_test_...), granted via
# POST /connectors/stripe/credentials, not set here.

# --- connectors/linkedin ---
# Per-tenant long-lived access token, granted via POST /connectors/linkedin/credentials,
# not set here.

# --- connectors/x ---
# Per-tenant long-lived access token, granted via POST /connectors/x/credentials,
# not set here.

# --- connectors/discord ---
# Per-tenant bot token, granted via POST /connectors/discord/credentials, not set
# here. Create a bot at discord.com/developers/applications.

# --- connectors/trello ---
# Per-tenant "apiKey:apiToken" pair, granted via POST /connectors/trello/credentials,
# not set here.

# --- connectors/mongodb ---
# Per-tenant connection string to the tenant's OWN external database, granted via
# POST /connectors/mongodb/credentials, not set here.

# --- connectors/woocommerce ---
# Per-tenant "consumerKey:consumerSecret" pair (same shape as Trello's), granted via
# POST /connectors/woocommerce/credentials, not set here. storeUrl is passed as a
# tool argument, not env config, since one tenant may connect more than one store.

# --- connectors/gmail ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/gmail/credentials, not set here.

# --- connectors/google-sheets ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above. A tenant's refresh token is
# granted via POST /connectors/google-sheets/credentials, not set here.

# --- connectors/snapchat-ads ---
# Its own OAuth app (Snapchat Business Manager), not shared with any other
# connector. A tenant's refresh token is granted via
# POST /connectors/snapchat-ads/credentials, not set here. These two ARE static,
# shared across every tenant — they identify OmniMCP's own Snapchat OAuth app.
SNAPCHAT_CLIENT_ID=your-snapchat-oauth-client-id
SNAPCHAT_CLIENT_SECRET=your-snapchat-oauth-client-secret

# --- connectors/pinterest ---
# Its own OAuth app. Uses tokenAuthMethod "basic" (see connector.manifest.json) —
# these two ARE static, shared across every tenant. A tenant's refresh token is
# granted via POST /connectors/pinterest/credentials, not set here.
PINTEREST_CLIENT_ID=your-pinterest-oauth-client-id
PINTEREST_CLIENT_SECRET=your-pinterest-oauth-client-secret

# --- connectors/reddit ---
# Its own OAuth app ("script" or "web" type at reddit.com/prefs/apps). Uses
# tokenAuthMethod "basic" and authorizationExtraParams.duration=permanent (see
# connector.manifest.json) — without the latter Reddit never issues a refresh
# token at all. These two ARE static, shared across every tenant. A tenant's
# refresh token is granted via POST /connectors/reddit/credentials, not set here.
REDDIT_CLIENT_ID=your-reddit-oauth-client-id
REDDIT_CLIENT_SECRET=your-reddit-oauth-client-secret

# --- connectors/mailchimp ---
# Per-tenant API key, granted via POST /connectors/mailchimp/credentials, not set
# here. The datacenter (e.g. "us6") is embedded in the key's own suffix, nothing
# extra to configure.

# --- connectors/activecampaign ---
# Per-tenant "apiUrl|apiKey" pair (pipe-delimited, since the URL itself contains
# colons), granted via POST /connectors/activecampaign/credentials, not set here.

# --- connectors/klaviyo ---
# Per-tenant Private API Key, granted via POST /connectors/klaviyo/credentials,
# not set here.

# --- connectors/openai ---
# Per-tenant API key, granted via POST /connectors/openai/credentials, not set
# here — each tenant's own OpenAI usage is billed to their own key.

# --- connectors/zapier ---
# Per-tenant "Webhooks by Zapier" trigger URL (the credential IS the URL, not a
# token), granted via POST /connectors/zapier/credentials, not set here.

# --- connectors/make ---
# Per-tenant custom webhook trigger URL (the credential IS the URL), granted via
# POST /connectors/make/credentials, not set here.

# --- connectors/n8n ---
# Per-tenant API key for a self-hosted n8n instance's REST API (X-N8N-API-KEY),
# granted via POST /connectors/n8n/credentials, not set here. baseUrl/webhookUrl
# are passed as tool arguments since each tenant's instance lives at its own URL.

# --- connectors/mercado-libre ---
# Its own OAuth app. Uses refreshTokenRotates (see connector.manifest.json) —
# ConnectorProcessManager refreshes and re-persists the tenant's refresh token
# itself whenever it spawns a fresh connector process, since Mercado Libre
# invalidates the old refresh_token on every exchange. These two ARE static,
# shared across every tenant. A tenant's refresh token is granted via
# POST /connectors/mercado-libre/credentials, not set here.
MERCADOLIBRE_CLIENT_ID=your-mercadolibre-oauth-client-id
MERCADOLIBRE_CLIENT_SECRET=your-mercadolibre-oauth-client-secret

# --- connectors/twilio ---
# Per-tenant "accountSid|authToken" pair (pipe-delimited, same convention as
# ActiveCampaign), granted via POST /connectors/twilio/credentials, not set here.

# --- connectors/calendly ---
# Per-tenant Personal Access Token, granted via POST /connectors/calendly/credentials,
# not set here.

# --- connectors/docusign ---
# Its own OAuth app. A tenant's refresh token is granted via
# POST /connectors/docusign/credentials, not set here. These two ARE static,
# shared across every tenant. accountId/baseUri are resolved per-tenant via
# get_user_info and passed as tool arguments, not env config.
DOCUSIGN_CLIENT_ID=your-docusign-oauth-client-id
DOCUSIGN_CLIENT_SECRET=your-docusign-oauth-client-secret

# --- connectors/airtable ---
# Per-tenant Personal Access Token, granted via POST /connectors/airtable/credentials,
# not set here. baseId/tableName are passed as tool arguments since one tenant may
# use more than one base.

# --- apps/mcp-gateway only ---
# Identifies which tenant/user this gateway process acts as. Issue one via
# POST /api-keys after logging in, then set it in your MCP client's config.
OMNIMCP_API_KEY=
