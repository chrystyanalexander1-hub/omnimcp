{
  "id": "tiktok-ads",
  "displayName": "TikTok Ads",
  "version": "0.1.0",
  "transport": { "type": "stdio", "command": "node", "args": ["dist/index.js"] },
  "auth": {
    "type": "api_key",
    "envVar": "TIKTOK_ADS_ACCESS_TOKEN"
  },
  "tools": [
    {
      "name": "list_campaigns",
      "description": "List campaigns for a TikTok advertiser account.",
      "inputSchema": {
        "type": "object",
        "properties": { "advertiserId": { "type": "string" } },
        "required": ["advertiserId"],
        "additionalProperties": false
      },
      "sensitive": false
    },
    {
      "name": "get_campaign_report",
      "description": "Get performance metrics (impressions, clicks, spend, ctr) for one or more campaigns over a date range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "advertiserId": { "type": "string" },
          "campaignIds": { "type": "array", "items": { "type": "string" } },
          "startDate": { "type": "string", "description": "YYYY-MM-DD" },
          "endDate": { "type": "string", "description": "YYYY-MM-DD" }
        },
        "required": ["advertiserId", "campaignIds", "startDate", "endDate"],
        "additionalProperties": false
      },
      "sensitive": false
    },
    {
      "name": "create_campaign",
      "description": "Create a new TikTok advertising campaign. Spends real budget once activated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "advertiserId": { "type": "string" },
          "campaignName": { "type": "string" },
          "objectiveType": { "type": "string", "description": "e.g. TRAFFIC, CONVERSIONS, REACH, APP_PROMOTION" },
          "budgetMode": { "type": "string", "enum": ["BUDGET_MODE_DAY", "BUDGET_MODE_TOTAL"] },
          "budget": { "type": "number" }
        },
        "required": ["advertiserId", "campaignName", "objectiveType", "budgetMode", "budget"],
        "additionalProperties": false
      },
      "sensitive": true
    },
    {
      "name": "update_campaign_status",
      "description": "Pause, enable, or delete one or more campaigns, immediately changing whether they spend budget.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "advertiserId": { "type": "string" },
          "campaignIds": { "type": "array", "items": { "type": "string" } },
          "operationStatus": { "type": "string", "enum": ["ENABLE", "DISABLE", "DELETE"] }
        },
        "required": ["advertiserId", "campaignIds", "operationStatus"],
        "additionalProperties": false
      },
      "sensitive": true
    }
  ]
}
